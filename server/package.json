{
  "name": "figma-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server bridging AI agents to the Figma plugin runtime: remote MCP over Streamable HTTP (port 10030+id) plus a WebSocket bridge for the Figma plugin (port 10060+id). Installs a `figma-mcp` CLI command.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "figma",
    "figma-plugin",
    "ai-agent",
    "design-automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatorhub/figma-mcp.git",
    "directory": "server"
  },
  "main": "src/index.js",
  "bin": {
    "figma-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
